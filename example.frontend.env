# Frontend configuration.
# Copy this file to `.frontend.env` and adjust the values.

# Public (browser-facing) URL of the backend API.
PUBLIC_API_HOST=http://localhost:8080
# Public (browser-facing) URL of the LibreTranslate service. Leave empty to disable.
PUBLIC_TRANSLATION_API_HOST=http://localhost:5000
# Internal URL the frontend server uses to reach the backend (container-to-container).
PUBLIC_INTERNAL_API_HOST=http://whishper-backend:8080
# Transcription profile: cpu or gpu.
PUBLIC_WHISHPER_PROFILE=cpu
