# Backend / transcription-api / database configuration.
# Copy this file to `.backend.env` and adjust the values.

# Where uploaded media is stored inside the containers. The backend and the
# transcription API must share this path (they mount the same volume).
UPLOAD_DIR=/uploads

# Internal service endpoints (host:port). For the default single-machine setup
# these are already wired in docker-compose.yml. Override them here only if you
# run the transcription API / translation on a different machine.
ASR_ENDPOINT=whishper-api:8000
TRANSLATION_ENDPOINT=translate:5000
DB_ENDPOINT=whishper-mongo:27017

# Database credentials.
DB_USER=whishper
DB_PASS=whishper

# Whisper models to preload (comma separated): tiny, base, small, medium, large-v2, large-v3.
WHISPER_MODELS=tiny,small
# CPU threads used by Faster-Whisper (CPU profile only).
CPU_THREADS=4

# LibreTranslate: languages to load (comma separated). Fewer = faster startup.
LT_LOAD_ONLY=en,es,fr
